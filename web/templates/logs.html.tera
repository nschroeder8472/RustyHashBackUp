{% extends "base" %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">Logs</h1>
        <div class="flex space-x-3">
            <button class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition-colors"
                    onclick="refreshLogs()">
                <svg class="inline w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh
            </button>
            <button class="px-4 py-2 bg-red-700 hover:bg-red-800 text-white rounded-lg transition-colors"
                    onclick="clearLogs()">
                <svg class="inline w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                Clear Logs
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card-sm">
        <div class="grid grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Log Level</label>
                <select class="input-field-sm w-full"
                        id="log-level-filter"
                        onchange="filterLogs()">
                    <option value="all" selected>All Levels</option>
                    <option value="error">Error</option>
                    <option value="warn">Warning</option>
                    <option value="info">Info</option>
                    <option value="debug">Debug</option>
                    <option value="trace">Trace</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Time Range</label>
                <select class="input-field-sm w-full"
                        id="time-range-filter"
                        onchange="filterLogs()">
                    <option value="1h">Last Hour</option>
                    <option value="6h">Last 6 Hours</option>
                    <option value="24h" selected>Last 24 Hours</option>
                    <option value="7d">Last 7 Days</option>
                    <option value="all">All Time</option>
                </select>
            </div>
            <div class="col-span-2">
                <label class="block text-sm font-medium text-gray-300 mb-2">Search</label>
                <input type="text"
                       class="input-field-sm w-full"
                       placeholder="Search logs..."
                       id="log-search"
                       oninput="debouncedFilterLogs()">
            </div>
        </div>
    </div>

    <!-- Log Statistics -->
    <div class="grid grid-cols-5 gap-4"
         hx-get="/api/logs/stats"
         hx-trigger="load, every 30s"
         hx-swap="innerHTML">
        <!-- Loading placeholders -->
        <div class="bg-dark-surface border border-l-4 border-l-gray-500 border-dark-border rounded-lg p-4">
            <div class="text-center text-gray-500 py-2">
                <p class="text-xs">Loading...</p>
            </div>
        </div>
        <div class="bg-dark-surface border border-l-4 border-l-gray-500 border-dark-border rounded-lg p-4">
            <div class="text-center text-gray-500 py-2">
                <p class="text-xs">Loading...</p>
            </div>
        </div>
        <div class="bg-dark-surface border border-l-4 border-l-gray-500 border-dark-border rounded-lg p-4">
            <div class="text-center text-gray-500 py-2">
                <p class="text-xs">Loading...</p>
            </div>
        </div>
        <div class="bg-dark-surface border border-l-4 border-l-gray-500 border-dark-border rounded-lg p-4">
            <div class="text-center text-gray-500 py-2">
                <p class="text-xs">Loading...</p>
            </div>
        </div>
        <div class="bg-dark-surface border border-l-4 border-l-gray-500 border-dark-border rounded-lg p-4">
            <div class="text-center text-gray-500 py-2">
                <p class="text-xs">Loading...</p>
            </div>
        </div>
    </div>

    <!-- Log Entries -->
    <div class="card p-0">
        <div class="p-4 border-b border-dark-border">
            <h2 class="section-heading mb-0">Log Entries</h2>
        </div>

        <div class="divide-y divide-dark-border max-h-[600px] overflow-y-auto"
             id="log-entries"
             hx-get="/api/logs"
             hx-trigger="load"
             hx-swap="innerHTML">

            <!-- Loading placeholder -->
            <div class="p-8 text-center text-gray-500">
                <svg class="w-8 h-8 mx-auto mb-3 animate-spin text-gray-600" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <p class="text-sm">Loading logs...</p>
            </div>
        </div>

        <!-- Pagination -->
        <div class="p-4 border-t border-dark-border flex items-center justify-between" id="log-pagination">
            <p class="text-sm text-gray-400">
                Page <span class="text-white" id="current-page-num">1</span>
            </p>
            <div class="flex space-x-2">
                <button class="px-3 py-1 bg-dark-bg border border-dark-border rounded text-sm text-gray-400 hover:text-white hover:border-purple-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                        id="prev-page-btn" onclick="changePage(-1)" disabled>
                    Previous
                </button>
                <span class="px-3 py-1 text-sm text-white" id="current-page-display">Page 1</span>
                <button class="px-3 py-1 bg-dark-bg border border-dark-border rounded text-sm text-gray-400 hover:text-white hover:border-purple-500 transition-colors"
                        id="next-page-btn" onclick="changePage(1)">
                    Next
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 0;
    const pageSize = 50;
    let filterTimeout = null;

    function refreshLogs() {
        currentPage = 0;
        filterLogs();
    }

    function debouncedFilterLogs() {
        clearTimeout(filterTimeout);
        filterTimeout = setTimeout(() => {
            currentPage = 0; // Reset to first page on new search
            filterLogs();
        }, 300);
    }

    function clearLogs() {
        if (!confirm('Are you sure you want to clear all logs?')) return;

        fetch('/api/logs/clear', { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    refreshLogs();
                    // Refresh stats too
                    htmx.trigger(document.querySelector('[hx-get="/api/logs/stats"]'), 'load');
                } else {
                    showToast(data.message, 'error');
                }
            })
            .catch(error => showToast('Failed to clear logs', 'error'));
    }

    function changePage(delta) {
        currentPage = Math.max(0, currentPage + delta);
        filterLogs();
    }

    function filterLogs() {
        // Build API URL with query parameters
        const level = document.getElementById('log-level-filter').value;
        const timeRange = document.getElementById('time-range-filter').value;
        const search = document.getElementById('log-search').value;

        // Calculate 'since' timestamp based on time range
        let since = null;
        const now = Math.floor(Date.now() / 1000); // Current Unix timestamp in seconds

        switch(timeRange) {
            case '1h':
                since = now - (60 * 60);
                break;
            case '6h':
                since = now - (6 * 60 * 60);
                break;
            case '24h':
                since = now - (24 * 60 * 60);
                break;
            case '7d':
                since = now - (7 * 24 * 60 * 60);
                break;
            case 'all':
            default:
                since = null;
                break;
        }

        // Build query parameters
        const params = new URLSearchParams();
        if (level !== 'all') {
            params.append('level', level.toUpperCase());
        }
        if (since !== null) {
            params.append('since', since);
        }
        if (search) {
            params.append('search', search);
        }

        // Add pagination params
        params.append('limit', pageSize);
        params.append('offset', currentPage * pageSize);

        // Make HTMX request to the API
        const url = '/api/logs?' + params.toString();
        htmx.ajax('GET', url, {
            target: '#log-entries',
            swap: 'innerHTML'
        });

        // Update pagination UI
        updatePaginationUI();
    }

    function updatePaginationUI() {
        const pageNum = currentPage + 1;
        document.getElementById('current-page-num').textContent = pageNum;
        document.getElementById('current-page-display').textContent = `Page ${pageNum}`;

        // Update button states
        const prevBtn = document.getElementById('prev-page-btn');
        const nextBtn = document.getElementById('next-page-btn');

        prevBtn.disabled = currentPage === 0;

        // Note: We can't disable next button without knowing total count
        // It will just show empty results on the last page + 1
    }
</script>
{% endblock %}
